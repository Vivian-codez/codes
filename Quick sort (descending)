//3c
#include <iostream>
using namespace std;

// Function to partition the array
int partition(float ratings[], int low, int high)
{
    float pivot = ratings[high];
    int i = low - 1;

    for (int j = low; j < high; j++)
    {
        // For descending order
        if (ratings[j] >= pivot)
        {
            i++;

            float temp = ratings[i];
            ratings[i] = ratings[j];
            ratings[j] = temp;
        }
    }

    float temp = ratings[i + 1];
    ratings[i + 1] = ratings[high];
    ratings[high] = temp;

    return i + 1;
}

// Quick Sort function
void quickSort(float ratings[], int low, int high)
{
    if (low < high)
    {
        int pi = partition(ratings, low, high);

        quickSort(ratings, low, pi - 1);
        quickSort(ratings, pi + 1, high);
    }
}

int main()
{
    int n;

    cout << "Enter number of products: ";
    cin >> n;

    float ratings[n];

    // Taking ratings as input
    cout << "Enter product ratings (0 to 5):" << endl;

    for (int i = 0; i < n; i++)
    {
        cout << "Rating of Product " << i + 1 << ": ";
        cin >> ratings[i];
    }

    // Sorting using Quick Sort
    quickSort(ratings, 0, n - 1);

    // Display sorted ratings
    cout << "\nProduct ratings in descending order:" << endl;

    for (int i = 0; i < n; i++)
    {
        cout << ratings[i] << " ";
    }

    cout << endl;

    return 0;
}

//3D
#include <iostream>
using namespace std;

// Function to merge two sorted parts
void merge(int experience[], int left, int mid, int right)
{
    int n1 = mid - left + 1;
    int n2 = right - mid;

    int L[n1], R[n2];

    // Copy elements into temporary arrays
    for (int i = 0; i < n1; i++)
        L[i] = experience[left + i];

    for (int j = 0; j < n2; j++)
        R[j] = experience[mid + 1 + j];

    int i = 0, j = 0, k = left;

    // Merge in descending order
    while (i < n1 && j < n2)
    {
        if (L[i] >= R[j])
        {
            experience[k] = L[i];
            i++;
        }
        else
        {
            experience[k] = R[j];
            j++;
        }
        k++;
    }

    // Copy remaining elements of L[]
    while (i < n1)
    {
        experience[k] = L[i];
        i++;
        k++;
    }

    // Copy remaining elements of R[]
    while (j < n2)
    {
        experience[k] = R[j];
        j++;
        k++;
    }
}

// Merge Sort function
void mergeSort(int experience[], int left, int right)
{
    if (left < right)
    {
        int mid = left + (right - left) / 2;

        mergeSort(experience, left, mid);
        mergeSort(experience, mid + 1, right);

        merge(experience, left, mid, right);
    }
}

int main()
{
    int n;

    cout << "Enter number of job applicants: ";
    cin >> n;

    int experience[n];

    // Input experience
    cout << "Enter experience of each applicant (in years):" << endl;

    for (int i = 0; i < n; i++)
    {
        cout << "Applicant " << i + 1 << ": ";
        cin >> experience[i];
    }

    // Sort using Merge Sort
    mergeSort(experience, 0, n - 1);

    // Display sorted experience
    cout << "\nJob applicants sorted by experience (descending order):"
         << endl;

    for (int i = 0; i < n; i++)
    {
        cout << "Applicant " << i + 1
             << " - " << experience[i] << " years" << endl;
    }

    return 0;
}
