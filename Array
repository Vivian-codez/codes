#include <iostream>
using namespace std;

int main()
{
    int n;

    cout << "===== Student Mark Analysis System =====" << endl;
    cout << "Enter the number of students: ";
    cin >> n;

    int marks[100];

    // Input marks
    cout << "\nEnter marks of " << n << " students:" << endl;
    for (int i = 0; i < n; i++)
    {
        cout << "Student " << i + 1 << ": ";
        cin >> marks[i];
    }

    // Display marks
    cout << "\nStudent Marks:" << endl;
    for (int i = 0; i < n; i++)
    {
        cout << "Student " << i + 1 << " = " << marks[i] << endl;
    }

    // Initialize variables
    int total = 0;
    int highest = marks[0];
    int lowest = marks[0];
    int pass = 0, fail = 0;

    // Analysis
    for (int i = 0; i < n; i++)
    {
        total += marks[i];

        if (marks[i] > highest)
            highest = marks[i];

        if (marks[i] < lowest)
            lowest = marks[i];

        if (marks[i] >= 40)
            pass++;
        else
            fail++;
    }

    float average = (float)total / n;

    // Display Result
    cout << "\n===== Analysis Result =====" << endl;
    cout << "Total Marks = " << total << endl;
    cout << "Average Marks = " << average << endl;
    cout << "Highest Marks = " << highest << endl;
    cout << "Lowest Marks = " << lowest << endl;
    cout << "Number of Passed Students = " << pass << endl;
    cout << "Number of Failed Students = " << fail << endl;

    return 0;
}
