#include <iostream>
using namespace std;

int main() {
    const int MAX = 100;
    int arr[MAX];
    int n, choice;

    cout << "Enter the number of elements: ";
    cin >> n;

    cout << "Enter " << n << " elements: " << endl;
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    do {
        cout << "\n====== ARRAY OPERATIONS ======" << endl;
        cout << "1. INSERT ELEMENT" << endl;
        cout << "2. UPDATE ELEMENT" << endl;
        cout << "3. DELETE ELEMENT" << endl;
        cout << "4. DISPLAY ELEMENT" << endl;
        cout << "5. EXIT" << endl;
        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice) {
            case 1: {
                int element, position;
                cout << "Enter the position to insert (1 to " << n + 1 << "): ";
                cin >> position;

                if (position < 1 || position > n + 1) {
                    cout << "INVALID Position" << endl;
                } else {
                    cout << "Enter the element: ";
                    cin >> element;

                    for (int i = n; i >= position; i--) {
                        arr[i] = arr[i - 1];
                    }

                    arr[position - 1] = element;
                    n++;
                    cout << "Element is inserted succesfully!" << endl;
                }
                break;
            }

            case 2: {
                int position, value;
                cout << "Enter the position to update (1 to " << n + 1 << "): ";
                cin >> position;

                if (position < 1 || position > n) {
                    cout << "INVALID Position" << endl;
                } else {
                    cout << "Enter new value: ";
                    cin >> value;

                    arr[position - 1] = value;
                    cout << "Element is updated succesfully!" << endl;
                }
                break;
            }

            case 3: {
                int position;
                cout << "Enter the position to delete (1 to " << n + 1 << "): ";
                cin >> position;

                if (position < 1 || position > n + 1) {
                    cout << "INVALID Position" << endl;
                } else {
                    for (int i = position - 1; i < n; i++) {
                        arr[i] = arr[i + 1];
                    }

                    n--;
                    cout << "Element is deleted succesfully!" << endl;
                }
                break;
            }

            case 4: {
                if (n == 0) {
                    cout << "Array is Empty." << endl;
                } else {
                    cout << "Array Elements: ";
                    for (int i = 0; i < n; i++) {
                        cout << arr[i] << " ";
                    }
                                        cout << endl;
                }
                break;
            }

            case 5:
                cout << "Program Exited." << endl;
                break;

            default:
                cout << "Invalid Choice!" << endl;
        }
    } while (choice != 5);

    return 0;
}
