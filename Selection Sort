#include <iostream>
using namespace std;
int main()
{
    int n, i, j, minIndex, temp;

    // Input number of students
    cout << "Enter number of students: ";
    cin >> n;

    int marks[n];

    // Input marks
    cout << "Enter marks of " << n << " students:" << endl;
    for (i = 0; i < n; i++)
    {
        cout << "Student " << i + 1 << ": ";
        cin >> marks[i];
    }

    // Selection Sort
    for (i = 0; i < n - 1; i++)
    {
        minIndex = i;

        for (j = i + 1; j < n; j++)
        {
            if (marks[j] < marks[minIndex])
            {
                minIndex = j;
            }
        }

        // Swap
        temp = marks[i];
        marks[i] = marks[minIndex];
        marks[minIndex] = temp;
    }

    // Display sorted marks
    cout << "\nStudent marks in ascending order:" << endl;
    for (i = 0; i < n; i++)
    {
        cout << marks[i] << " ";
    }

    return 0;
}
