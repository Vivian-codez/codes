#include <iostream>
#include <string>
using namespace std;

// Node structure
struct Node
{
    int rollNo;
    string name;
    float marks;
    Node* next;
};

// Head pointer
Node* head = NULL;

// Function to insert a student
void insertStudent()
{
    Node* newNode = new Node();

    cout << "\nEnter Roll Number: ";
    cin >> newNode->rollNo;

    cout << "Enter Student Name: ";
    cin >> newNode->name;

    cout << "Enter Marks: ";
    cin >> newNode->marks;

    newNode->next = NULL;

    // If list is empty
    if (head == NULL)
    {
        head = newNode;
    }
    else
    {
        Node* temp = head;

        while (temp->next != NULL)
        {
            temp = temp->next;
        }

        temp->next = newNode;
    }

    cout << "\nStudent inserted successfully!\n";
}

// Function to display all students
void displayStudents()
{
    if (head == NULL)
    {
        cout << "\nList is empty!\n";
        return;
    }

    Node* temp = head;

    cout << "\n--- Student Records ---\n";

    while (temp != NULL)
    {
        cout << "Roll No: " << temp->rollNo << endl;
        cout << "Name   : " << temp->name << endl;
        cout << "Marks  : " << temp->marks << endl;
        cout << "-----------------------\n";

        temp = temp->next;
    }
}

// Function to search a student
void searchStudent()
{
    int roll;
    cout << "\nEnter Roll Number to search: ";
    cin >> roll;

    Node* temp = head;

    while (temp != NULL)
    {
        if (temp->rollNo == roll)
        {
            cout << "\nStudent Found!\n";
            cout << "Roll No: " << temp->rollNo << endl;
            cout << "Name   : " << temp->name << endl;
            cout << "Marks  : " << temp->marks << endl;
            return;
        }

        temp = temp->next;
    }

    cout << "\nStudent not found!\n";
}

// Function to update a student
void updateStudent()
{
    int roll;

    cout << "\nEnter Roll Number to update: ";
    cin >> roll;

    Node* temp = head;

    while (temp != NULL)
    {
        if (temp->rollNo == roll)
        {
            cout << "Enter New Name: ";
            cin >> temp->name;

            cout << "Enter New Marks: ";
            cin >> temp->marks;

            cout << "\nStudent record updated successfully!\n";
            return;
        }

        temp = temp->next;
    }

    cout << "\nStudent not found!\n";
}

// Function to delete a student
void deleteStudent()
{
    int roll;

    cout << "\nEnter Roll Number to delete: ";
    cin >> roll;

    Node* temp = head;
    Node* previous = NULL;

    // If first node is to be deleted
    if (temp != NULL && temp->rollNo == roll)
    {
        head = temp->next;
        delete temp;

        cout << "\nStudent deleted successfully!\n";
        return;
    }

    // Search for the node
    while (temp != NULL && temp->rollNo != roll)
    {
        previous = temp;
        temp = temp->next;
    }

    // Student not found
    if (temp == NULL)
    {
        cout << "\nStudent not found!\n";
        return;
    }

    // Delete the node
    previous->next = temp->next;
    delete temp;

    cout << "\nStudent deleted successfully!\n";
}

// Function to sort students according to marks
void sortStudents()
{
    if (head == NULL || head->next == NULL)
    {
        cout << "\nNot enough records to sort!\n";
        return;
    }

    Node* i;
    Node* j;

    for (i = head; i->next != NULL; i = i->next)
    {
        for (j = i->next; j != NULL; j = j->next)
        {
            if (i->marks > j->marks)
            {
                // Swap data, not nodes
                swap(i->rollNo, j->rollNo);
                swap(i->name, j->name);
                swap(i->marks, j->marks);
            }
        }
    }

    cout << "\nStudents sorted according to marks!\n";
}

// Main function
int main()
{
    int choice;

    do
    {
        cout << "\n================================";
        cout << "\n Student Record Management";
        cout << "\n Singly Linked List";
        cout << "\n================================";
        cout << "\n1. Insert Student";
        cout << "\n2. Update Student";
        cout << "\n3. Search Student";
        cout << "\n4. Sort Students";
        cout << "\n5. List All Students";
        cout << "\n6. Delete Student";
        cout << "\n7. Exit";
        cout << "\n================================";

        cout << "\nEnter your choice: ";
        cin >> choice;

        switch (choice)
        {
            case 1:
                insertStudent();
                break;

            case 2:
                updateStudent();
                break;

            case 3:
                searchStudent();
                break;

            case 4:
                sortStudents();
                break;

            case 5:
                displayStudents();
                break;

            case 6:
                deleteStudent();
                break;

            case 7:
                cout << "\nProgram terminated.\n";
                break;

            default:
                cout << "\nInvalid choice! Try again.\n";
        }

    } while (choice != 7);

    return 0;
}

