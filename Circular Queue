#include <iostream>
#include <string>
using namespace std;

#define SIZE 5

class CircularQueue {
    string requests[SIZE];
    int front, rear, count;

public:
    CircularQueue() {
        front = 0;
        rear = -1;
        count = 0;
    }

    // Add a new service request
    void enqueue(string request) {
        if (count == SIZE) {
            cout << "Queue is full! Cannot add request.\n";
            return;
        }

        rear = (rear + 1) % SIZE;
        requests[rear] = request;
        count++;

        cout << "Request added: " << request << endl;
    }

    // Resolve the oldest service request
    void dequeue() {
        if (count == 0) {
            cout << "No pending service requests.\n";
            return;
        }

        cout << "Request resolved: "
             << requests[front] << endl;

        front = (front + 1) % SIZE;
        count--;
    }

    // Display pending service requests
    void display() {
        if (count == 0) {
            cout << "No pending requests.\n";
            return;
        }

        cout << "\nPending Service Requests:\n";

        for (int i = 0; i < count; i++) {
            int index = (front + i) % SIZE;
            cout << requests[index] << endl;
        }
    }
};

int main() {
    CircularQueue q;
    int choice;
    string request;

    do {
        cout << "\n--- Service Request Management ---\n";
        cout << "1. Add Request\n";
        cout << "2. Resolve Request\n";
        cout << "3. Display Requests\n";
        cout << "4. Exit\n";
        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice) {
            case 1:
                cout << "Enter service request: ";
                cin >> ws;
                getline(cin, request);
                q.enqueue(request);
                break;

            case 2:
                q.dequeue();
                break;

            case 3:
                q.display();
                break;

            case 4:
                cout << "Exiting system...\n";
                break;

            default:
                cout << "Invalid choice! Try again.\n";
        }
    } while (choice != 4);

    return 0;
}
