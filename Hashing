#include <iostream>
using namespace std;
const int SIZE = 10;
// Function to insert an element using Linear Probing
void insert(int hashTable[], int key)
{
    int index = key % SIZE;
    int originalIndex = index;

    while (hashTable[index] != -1)
    {
        index = (index + 1) % SIZE;

        if (index == originalIndex)
        {
            cout << "Hash Table is Full. Cannot insert " << key << endl;
            return;
        }
    }

    hashTable[index] = key;
    cout << key << " inserted at index " << index << endl;
}

// Function to search an element
void search(int hashTable[], int key)
{
    int index = key % SIZE;
    int originalIndex = index;

    while (hashTable[index] != -1)
    {
        if (hashTable[index] == key)
        {
            cout << "Element " << key << " found at index " << index << endl;
            return;
        }

        index = (index + 1) % SIZE;

        if (index == originalIndex)
            break;
    }

    cout << "Element " << key << " not found." << endl;
}

// Function to display hash table
void display(int hashTable[])
{
    cout << "\n----- Hash Table -----" << endl;

    for (int i = 0; i < SIZE; i++)
    {
        cout << "Index " << i << " : ";

        if (hashTable[i] == -1)
            cout << "Empty";
        else
            cout << hashTable[i];

        cout << endl;
    }
}

int main()
{
    int hashTable[SIZE];

    // Initialize hash table with -1
    for (int i = 0; i < SIZE; i++)
    {
        hashTable[i] = -1;
    }

    int n, key, choice;

    cout << "===== Hashing using Linear Probing =====" << endl;

    cout << "Enter number of elements to insert: ";
    cin >> n;

    cout << "\nEnter the elements:" << endl;

    for (int i = 0; i < n; i++)
    {
        cin >> key;
        insert(hashTable, key);
    }

    do
    {
        cout << "\n========== MENU ==========" << endl;
        cout << "1. Display Hash Table" << endl;
        cout << "2. Search Element" << endl;
        cout << "3. Exit" << endl;

        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice)
        {
        case 1:
            display(hashTable);
            break;

        case 2:
            cout << "Enter element to search: ";
            cin >> key;
            search(hashTable, key);
            break;

        case 3:
            cout << "Program Ended." << endl;
            break;

        default:
            cout << "Invalid Choice!" << endl;
        }

    } while (choice != 3);

    return 0;
}
