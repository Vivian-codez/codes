#include <iostream>
using namespace std;

// Function to merge two sorted parts
void merge(int prices[], int left, int mid, int right)
{
    int n1 = mid - left + 1;
    int n2 = right - mid;

    int L[n1], R[n2];

    // Copy data into temporary arrays
    for (int i = 0; i < n1; i++)
        L[i] = prices[left + i];

    for (int j = 0; j < n2; j++)
        R[j] = prices[mid + 1 + j];

    int i = 0, j = 0, k = left;

    // Merge the two arrays
    while (i < n1 && j < n2)
    {
        if (L[i] <= R[j])
        {
            prices[k] = L[i];
            i++;
        }
        else
        {
            prices[k] = R[j];
            j++;
        }
        k++;
    }

    // Copy remaining elements of L[]
    while (i < n1)
    {
        prices[k] = L[i];
        i++;
        k++;
    }

    // Copy remaining elements of R[]
    while (j < n2)
    {
        prices[k] = R[j];
        j++;
        k++;
    }
}

// Merge Sort function
void mergeSort(int prices[], int left, int right)
{
    if (left < right)
    {
        int mid = left + (right - left) / 2;

        mergeSort(prices, left, mid);
        mergeSort(prices, mid + 1, right);

        merge(prices, left, mid, right);
    }
}

int main()
{
    int n;

    cout << "Enter number of flight ticket prices: ";
    cin >> n;

    int prices[n];

    cout << "Enter " << n << " flight ticket prices:\n";

    for (int i = 0; i < n; i++)
    {
        cout << "Price " << i + 1 << ": ";
        cin >> prices[i];
    }

    // Sort prices using Merge Sort
    mergeSort(prices, 0, n - 1);

    cout << "\nFlight ticket prices in ascending order:\n";

    for (int i = 0; i < n; i++)
    {
        cout << prices[i] << " ";
    }

    cout << "\n\nLowest flight fare: " << prices[0] << endl;

    return 0;
}
