#include <iostream>
#include <stack>
#include <string>
#include <cctype>
using namespace std;

int main()
{
    string postfix;
    stack<int> s;

    cout << "Enter a postfix expression: ";
    cin >> postfix;

    for (int i = 0; i < postfix.length(); i++)
    {
        char ch = postfix[i];

        // If operand, push it onto the stack
        if (isdigit(ch))
        {
            s.push(ch - '0');
        }
        // If operator, perform the operation
        else
        {
            int b = s.top();
            s.pop();

            int a = s.top();
            s.pop();

            switch (ch)
            {
                case '+':
                    s.push(a + b);
                    break;

                case '-':
                    s.push(a - b);
                    break;

                case '*':
                    s.push(a * b);
                    break;

                case '/':
                    if (b == 0)
                    {
                        cout << "Division by zero error";
                        return 0;
                    }
                    s.push(a / b);
                    break;
            }
        }
    }

    cout << "Result = " << s.top();

    return 0;
}
