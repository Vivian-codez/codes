#include <iostream>
using namespace std;

class Node {
public:
    int data;
    Node* prev;
    Node* next;

    Node(int value) {
        data = value;
        prev = nullptr;
        next = nullptr;
    }
};

class DoublyLinkedList {
private:
    Node* head;

public:
    DoublyLinkedList() {
        head = nullptr;
    }

    // Insert at the end
    void insert(int value) {
        Node* newNode = new Node(value);

        if (head == nullptr) {
            head = newNode;
            cout << "Element inserted successfully.\n";
            return;
        }

        Node* temp = head;

        while (temp->next != nullptr) {
            temp = temp->next;
        }

        temp->next = newNode;
        newNode->prev = temp;

        cout << "Element inserted successfully.\n";
    }

    // Update an element
    void update(int oldValue, int newValue) {
        Node* temp = head;

        while (temp != nullptr) {
            if (temp->data == oldValue) {
                temp->data = newValue;
                cout << "Element updated successfully.\n";
                return;
            }
            temp = temp->next;
        }

        cout << "Element not found.\n";
    }

    // Search an element
    void search(int value) {
        Node* temp = head;
        int position = 1;

        while (temp != nullptr) {
            if (temp->data == value) {
                cout << "Element found at position: "
                     << position << endl;
                return;
            }

            temp = temp->next;
            position++;
        }

        cout << "Element not found.\n";
    }

    // Sort the linked list
    void sortList() {
        if (head == nullptr || head->next == nullptr) {
            cout << "List is already sorted.\n";
            return;
        }

        Node* i;
        Node* j;

        for (i = head; i != nullptr; i = i->next) {
            for (j = i->next; j != nullptr; j = j->next) {
                if (i->data > j->data) {
                    int temp = i->data;
                    i->data = j->data;
                    j->data = temp;
                }
            }
        }

        cout << "List sorted successfully.\n";
    }

    // Display from beginning to end
    void displayForward() {
        if (head == nullptr) {
            cout << "List is empty.\n";
            return;
        }

        Node* temp = head;

        cout << "List (Forward): ";

        while (temp != nullptr) {
            cout << temp->data << " ";
            temp = temp->next;
        }

        cout << endl;
    }

    // Display from end to beginning
    void displayBackward() {
        if (head == nullptr) {
            cout << "List is empty.\n";
            return;
        }

        Node* temp = head;

        while (temp->next != nullptr) {
            temp = temp->next;
        }

        cout << "List (Backward): ";

        while (temp != nullptr) {
            cout << temp->data << " ";
            temp = temp->prev;
        }

        cout << endl;
    }

    // Delete an element
    void deleteElement(int value) {
        Node* temp = head;

        while (temp != nullptr && temp->data != value) {
            temp = temp->next;
        }

        if (temp == nullptr) {
            cout << "Element not found.\n";
            return;
        }

        // If deleting the first node
        if (temp == head) {
            head = temp->next;

            if (head != nullptr) {
                head->prev = nullptr;
            }
        }
        else {
            temp->prev->next = temp->next;

            if (temp->next != nullptr) {
                temp->next->prev = temp->prev;
            }
        }

        delete temp;

        cout << "Element deleted successfully.\n";
    }
};

int main() {
    DoublyLinkedList list;
    int choice, value, oldValue, newValue;

    do {
        cout << "\n========== DOUBLY LINKED LIST ==========\n";
        cout << "1. Insert\n";
        cout << "2. Update\n";
        cout << "3. Search\n";
        cout << "4. Sort\n";
        cout << "5. Display Forward\n";
        cout << "6. Display Backward\n";
        cout << "7. Delete\n";
        cout << "8. Exit\n";
        cout << "========================================\n";

        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice) {

        case 1:
            cout << "Enter value to insert: ";
            cin >> value;
            list.insert(value);
            break;

        case 2:
            cout << "Enter value to update: ";
            cin >> oldValue;

            cout << "Enter new value: ";
            cin >> newValue;

            list.update(oldValue, newValue);
            break;

        case 3:
            cout << "Enter value to search: ";
            cin >> value;
            list.search(value);
            break;

        case 4:
            list.sortList();
            break;

        case 5:
            list.displayForward();
            break;

        case 6:
            list.displayBackward();
            break;

        case 7:
            cout << "Enter value to delete: ";
            cin >> value;
            list.deleteElement(value);
            break;

        case 8:
            cout << "Program terminated.\n";
            break;

        default:
            cout << "Invalid choice! Please try again.\n";
        }

    } while (choice != 8);

    return 0;
}
