#include <iostream>
#include <vector>
#include <queue>
using namespace std;

class Graph {
    int vertices;
    vector<int> adj[20];

public:
    Graph(int v) {
        vertices = v;
    }

    // Add connection between locations
    void addEdge(int u, int v) {
        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    // BFS to find shortest route
    void BFS(int start, int destination) {
        bool visited[20] = {false};
        int parent[20];

        for (int i = 0; i < vertices; i++) {
            parent[i] = -1;
        }

        queue<int> q;

        visited[start] = true;
        q.push(start);

        while (!q.empty()) {
            int current = q.front();
            q.pop();

            if (current == destination) {
                break;
            }

            for (int neighbour : adj[current]) {
                if (!visited[neighbour]) {
                    visited[neighbour] = true;
                    parent[neighbour] = current;
                    q.push(neighbour);
                }
            }
        }

        // Check whether destination is reachable
        if (!visited[destination]) {
            cout << "\nNo delivery route found!";
            return;
        }

        // Store shortest route
        vector<int> path;
        int current = destination;

        while (current != -1) {
            path.push_back(current);
            current = parent[current];
        }

        cout << "\nShortest delivery route: ";

        for (int i = path.size() - 1; i >= 0; i--) {
            cout << "Location " << path[i];

            if (i != 0)
                cout << " -> ";
        }

        cout << "\nMinimum number of roads: "
             << path.size() - 1;
    }
};

int main() {
    int v, e;
    
    cout << "Enter number of locations: ";
    cin >> v;

    Graph g(v);

    cout << "Enter number of roads: ";
    cin >> e;

    cout << "Enter roads (location1 location2):\n";

    for (int i = 0; i < e; i++) {
        int u, v;
        cin >> u >> v;
        g.addEdge(u, v);
    }

    int source, destination;

    cout << "Enter delivery starting location: ";
    cin >> source;

    cout << "Enter destination location: ";
    cin >> destination;

    g.BFS(source, destination);

    return 0;
}
